# Casa Puente demo configuration. Copy to `.env.testnet` or let `npm run deploy:testnet` write it.
# `.env.*` files are gitignored; only this example is tracked. Values here are placeholders.
#
# Testnet only: the VITE_ prefix puts every value, secrets included, into the browser bundle,
# because in this stage the demo "backend" (operator, issuer, buyer accounts) runs in the page.
# Never reuse these variable names with mainnet keys.

VITE_DEMO_MODE=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# payment_plan contract and the test asset's Stellar Asset Contract (both C... addresses)
VITE_PAYMENT_PLAN_CONTRACT_ID=C...
VITE_USDC_SAC_ID=C...

# Issuer of the platform TEST asset `USDC:<issuer>` (not Circle's USDC); its secret mints to buyers
VITE_USDC_ISSUER=G...
VITE_USDC_ISSUER_SECRET=S...

# Operator (also the contract admin in the demo) and the payee backend that receives releases
VITE_OPERATOR_PUBLIC=G...
VITE_OPERATOR_SECRET=S...
VITE_PAYEE_BACKEND_PUBLIC=G...
VITE_PAYEE_BACKEND_SECRET=S...

# Platform-managed testnet accounts of the three demo buyers ("Modo demo")
VITE_BUYER_PUBLIC_MARIA=G...
VITE_BUYER_SECRET_MARIA=S...
VITE_BUYER_PUBLIC_ANDRES=G...
VITE_BUYER_SECRET_ANDRES=S...
VITE_BUYER_PUBLIC_CAMILA=G...
VITE_BUYER_SECRET_CAMILA=S...

# plan_id (u32) of each seeded plan on the contract; "Reiniciar demo" creates new ones
VITE_CHAIN_PLAN_MARIA=0
VITE_CHAIN_PLAN_ANDRES=0
VITE_CHAIN_PLAN_CAMILA=0
