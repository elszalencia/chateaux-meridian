# Anchor Platform (receive side, SEP-31) environment. Copy to dev.env and fill the four secrets
# plus the two public keys; dev.env is gitignored. Variable names are the env form of the
# platform's YAML keys (sep10.home_domains -> SEP10_HOME_DOMAINS), taken from the v4 docs on
# 2026-10-22. Placeholders only: S... is a Stellar secret seed, G... a public key.

# --- SEP-1: serve dev.stellar.toml (mounted by docker-compose.yml) -------------------------------
SEP1_ENABLED=true
# Read the info file from a file inside the container (alternatives: string, url)
SEP1_TOML_TYPE=file
# Container path of the mounted dev.stellar.toml
SEP1_TOML_VALUE=/home/dev.stellar.toml

# --- SEP-10: web authentication ---------------------------------------------------------------
SEP10_ENABLED=true
# Comma-separated home domains the challenge is issued for (the docs use the plural key)
SEP10_HOME_DOMAINS=localhost:8080
# Domain the challenge transaction is signed for (defaults to the single home domain)
SEP10_WEB_AUTH_DOMAIN=localhost:8080
# Secret seed whose public key is SIGNING_KEY in dev.stellar.toml (testnet throwaway)
SECRET_SEP10_SIGNING_SEED=S...
# Key used to sign the SEP-10 session JWTs (any long random string, 32+ characters)
SECRET_SEP10_JWT_SECRET=change-me-sep10-jwt-secret-at-least-32-chars
# Leave false: the sender is not registered as a client; set true plus CLIENTS[0]_* to allow-list it
SEP10_CLIENT_ATTRIBUTION_REQUIRED=false
# Optional client allow-list (only used when attribution is required), indexed env form from the docs
# CLIENTS[0]_NAME=casa-puente-sender
# CLIENTS[0]_TYPE=custodial
# CLIENTS[0]_SIGNING_KEYS=G...PAYEE_BACKEND

# --- SEP-12 / SEP-31 / SEP-38 ---------------------------------------------------------------------
# KYC endpoints, proxied to the business server (GET/PUT/DELETE /customer)
SEP12_ENABLED=true
# Cross-border receive flow
SEP31_ENABLED=true
# STRICT_SEND: the sender pays the quoted amount and the fee comes out of it (docs default)
SEP31_PAYMENT_TYPE=STRICT_SEND
# `none`: the business server supplies destination_account and an id memo in request_onchain_funds;
# `self`: the platform generates the memo and uses distribution_account from dev.assets.yaml
SEP31_DEPOSIT_INFO_GENERATOR_TYPE=none
# Firm quotes (POST /sep38/quote with context sep31) proxied to GET /rate on the business server
SEP38_ENABLED=true

# --- Business server (Callback API) --------------------------------------------------------------
# Where the platform reaches our callbacks: /customer, /rate, /event (Docker network name)
CALLBACK_API_BASE_URL=http://business-server:8081
# Platform signs every callback request with an HS256 JWT (aud callback_api)
CALLBACK_API_AUTH_TYPE=jwt
# Lifetime of that JWT
CALLBACK_API_AUTH_JWT_EXPIRATION_MILLISECONDS=30000
# Shared HMAC key for callback JWTs (32+ characters; also read by the business server)
SECRET_CALLBACK_API_AUTH_SECRET=change-me-callback-secret-at-least-32-chars

# --- Platform API (business server -> platform-server JSON-RPC) ------------------------------------
# Used by the observer/event processor and by our business server to reach the Platform API
PLATFORM_API_BASE_URL=http://platform-server:8085
# Business server authenticates to the Platform API with an HS256 JWT (aud platform_api)
PLATFORM_API_AUTH_TYPE=jwt
# Shared HMAC key for Platform API JWTs (32+ characters; also read by the business server)
SECRET_PLATFORM_API_AUTH_SECRET=change-me-platform-secret-at-least-32-chars

# --- Stellar network (testnet) ---------------------------------------------------------------------
STELLAR_NETWORK_NETWORK=TESTNET
# Read the ledger through Stellar RPC (the quick-run example) rather than Horizon
STELLAR_NETWORK_TYPE=rpc
STELLAR_NETWORK_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Assets --------------------------------------------------------------------------------------
ASSETS_TYPE=file
ASSETS_VALUE=/home/dev.assets.yaml

# --- Database (Postgres service `db` in docker-compose.yml) --------------------------------------
DATA_TYPE=postgres
DATA_SERVER=db:5432
DATA_DATABASE=postgres
# Let the platform create its schema on first start
DATA_FLYWAY_ENABLED=true
SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=change-me-postgres-password
# Same credentials, read by the postgres image itself
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# --- Events ---------------------------------------------------------------------------------------
# Webhooks to POST /event need Kafka (the only broker the v4 docs support); off until a broker exists.
EVENTS_ENABLED=false
# EVENTS_QUEUE_TYPE=kafka
# EVENTS_QUEUE_KAFKA_BOOTSTRAP_SERVER=kafka:29092
# EVENT_PROCESSOR_CALLBACK_API_REQUEST_ENABLED=true

# --- Business server only ---------------------------------------------------------------------------
# Move SEP-31 transactions along automatically (pending_receiver -> pending_sender -> completed)
AUTO_COMPLETE=true
# Poll interval for GET /transactions while events are off
AUTO_COMPLETE_POLL_MS=5000
# Account the sender pays (same as distribution_account in dev.assets.yaml); required when
# SEP31_DEPOSIT_INFO_GENERATOR_TYPE=none, leave empty when it is `self`
DISTRIBUTION_ACCOUNT=G...DISTRIBUTION
# SEP-38 id of the test asset, exactly as in dev.assets.yaml
USDC_ASSET=stellar:USDC:G...USDC_ISSUER
