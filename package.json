{
  "name": "chateaux",
  "private": true,
  "version": "0.1.0",
  "description": "Chateaux: cross-border installment payments for Constructora Bolivar buyers abroad, on Stellar.",
  "workspaces": [
    "services",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo:mock": "npm run dev -w web -- --open",
    "demo:testnet": "node scripts/demo-testnet.mjs",
    "server:testnet": "tsx services/server/src/main.ts",
    "infra:up": "node scripts/infra-up.mjs",
    "deploy:testnet": "tsx scripts/deploy-testnet.mts",
    "smoke:testnet": "tsx scripts/testnet-smoke.mts",
    "deploy:sv": "tsx scripts/deploy-sv-instance.mts",
    "check:sv-testnet": "tsx scripts/sv-testnet-check.mts",
    "sim:testnet": "tsx scripts/sim-testnet.mts",
    "jobs:run": "node scripts/jobs-run.mjs",
    "test": "npm test -w services && npm test -w web && npm run check:db && npm run check:names",
    "check:db": "tsx scripts/check-db.mts",
    "check:names": "tsx scripts/check-names.mts",
    "test:e2e": "npm run test:e2e -w web",
    "test:e2e:testnet": "npm exec -w web -- playwright test -c playwright.testnet.config.ts",
    "test:all": "npm test && npm run test:e2e",
    "reset": "tsx scripts/reset.mts",
    "typecheck": "npm run typecheck -w services && npm run typecheck -w web && tsc --noEmit -p infra/receiver",
    "build": "npm run build -w web",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0"
  }
}
